From 1ca13e9d749771c54f5db0c873820f50968b3144 Mon Sep 17 00:00:00 2001
From: Abhirams144 <sureshabhiram92@gmail.com>
Date: Sat, 7 Nov 2026 02:26:47 +0530
Subject: [PATCH 4/4] cubic: fix unsigned underflow of the Reno-friendly AIMD
 accumulator

AimdAccumulator was reduced by the already-grown AimdWindow. Whenever the
accumulator exceeded AimdWindow by less than one MSS - the common case
with ACKs of one or two packets - the uint32 subtraction wrapped to ~4e9.
From then on every ACK grew AimdWindow by one MSS, and in the
Reno-friendly region cwnd = AimdWindow, so cwnd grew at slow-start speed
in congestion avoidance until the wrapped value drained.

Subtract the window that was crossed before growing it. Add a test for
a crossing smaller than one MSS, and update the two tests that encoded
the old order (one of them sized its ACKs to avoid the underflow).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/core/cubic.c                |  9 +++++-
 src/core/unittest/CubicTest.cpp | 49 +++++++++++++++++++++++++++------
 2 files changed, 48 insertions(+), 10 deletions(-)

diff --git a/src/core/cubic.c b/src/core/cubic.c
index e85d38c41..7ebb2632e 100644
--- a/src/core/cubic.c
+++ b/src/core/cubic.c
@@ -714,8 +714,15 @@ CubicCongestionControlOnDataAcknowledged(
             Cubic->AimdAccumulator += BytesAcked;
         }
         if (Cubic->AimdAccumulator > Cubic->AimdWindow) {
-            Cubic->AimdWindow += DatagramPayloadLength;
+            //
+            // Subtract the window the accumulator was compared against before
+            // growing it. Subtracting the grown window underflows (uint32)
+            // whenever the accumulator exceeds AimdWindow by less than one
+            // MSS; the wrapped value then grows AimdWindow, and with it cwnd
+            // in the Reno-friendly region, by 1 MSS on every ACK.
+            //
             Cubic->AimdAccumulator -= Cubic->AimdWindow;
+            Cubic->AimdWindow += DatagramPayloadLength;
         }
 
         if (Cubic->AimdWindow > CubicWindow) {
diff --git a/src/core/unittest/CubicTest.cpp b/src/core/unittest/CubicTest.cpp
index 81383a87b..476284ef6 100644
--- a/src/core/unittest/CubicTest.cpp
+++ b/src/core/unittest/CubicTest.cpp
@@ -736,8 +736,8 @@ TEST_F(CubicTest, CongestionAvoidance_AIMDvsCubicSelection)
 // growth across several rounds. After entering congestion avoidance with
 // AimdWindow >= WindowPrior (full-rate accumulation), each ACK of BytesAcked
 // bytes adds BytesAcked to AimdAccumulator. When AimdAccumulator exceeds
-// AimdWindow, the window grows by 1 DatagramPayloadLength and the accumulator
-// wraps by subtracting the new AimdWindow. Over N ACKs, AimdWindow should
+// AimdWindow, the crossed window is subtracted from the accumulator and the
+// window grows by 1 DatagramPayloadLength. Over N ACKs, AimdWindow should
 // grow by exactly floor(totalBytesAcked / averageAimdWindow) * DPL,
 // demonstrating the linear AIMD convergence required by RFC 8312 §4.3.
 //
@@ -776,9 +776,9 @@ TEST_F(CubicTest, AIMD_SequentialLinearConvergence)
 
         // Full-rate: accumulator += BytesAcked
         ExpectedAccumulator += BytesAcked;
-        // Accumulator exceeds AimdWindow → grow by 1 DPL
-        ExpectedAimdWindow += DatagramPayloadLength;
+        // Accumulator exceeds AimdWindow → consume that window, grow by 1 DPL
         ExpectedAccumulator -= ExpectedAimdWindow;
+        ExpectedAimdWindow += DatagramPayloadLength;
 
         ASSERT_EQ(Cubic->AimdWindow, ExpectedAimdWindow)
             << "AimdWindow mismatch after ACK " << (i + 1);
@@ -1871,8 +1871,6 @@ TEST_F(CubicTest, AIMD_AccumulatorTriggersWindowGrowth)
 
     // Set AimdWindow small enough that a single ACK triggers growth.
     // Use full-rate path: AimdWindow >= WindowPrior.
-    // BytesAcked must exceed AimdWindow + DatagramPayloadLength to avoid
-    // unsigned underflow in the subtraction (AimdAccumulator -= AimdWindow).
     uint32_t SmallAimdWindow = 100;
     Cubic->AimdWindow = SmallAimdWindow;
     Cubic->WindowPrior = SmallAimdWindow; // AimdWindow >= WindowPrior → full-rate
@@ -1886,10 +1884,43 @@ TEST_F(CubicTest, AIMD_AccumulatorTriggersWindowGrowth)
     CC->QuicCongestionControlOnDataAcknowledged(CC, &GrowthAck);
 
     // Full-rate: AimdAccumulator += BytesAcked = 1432. 1432 > 100 → trigger growth.
-    // AimdWindow = 100 + DatagramPayloadLength = 1332
-    // AimdAccumulator = 1432 - 1332 = 100
+    // The window that was crossed (100) is consumed, then AimdWindow grows:
+    // AimdAccumulator = 1432 - 100 = 1332, AimdWindow = 100 + DatagramPayloadLength.
     ASSERT_EQ(Cubic->AimdWindow, SmallAimdWindow + DatagramPayloadLength);
-    ASSERT_EQ(Cubic->AimdAccumulator, BytesAcked - (SmallAimdWindow + DatagramPayloadLength));
+    ASSERT_EQ(Cubic->AimdAccumulator, BytesAcked - SmallAimdWindow);
+}
+
+//
+// Test: AIMD Accumulator - no unsigned underflow
+// Scenario: the accumulator crosses AimdWindow by less than one MSS, which is
+// the common case (ACKs of one or two packets). The accumulator must keep the
+// small remainder. Before the fix it wrapped to ~4e9, after which every ACK
+// grew AimdWindow (and cwnd in the Reno-friendly region) by one MSS.
+//
+TEST_F(CubicTest, AIMD_AccumulatorNoUnderflow)
+{
+    InitializeDefaultWithRtt(/*WindowPackets = */ 10, /*HyStart = */ true);
+    const uint16_t DatagramPayloadLength = QuicPathGetDatagramPayloadSize(&Connection.Paths[0]);
+
+    EnterCongestionAvoidance();
+
+    const uint32_t Window = 20 * DatagramPayloadLength;
+    Cubic->AimdWindow = Window;
+    Cubic->WindowPrior = Window;          // full-rate accumulation
+    Cubic->AimdAccumulator = Window - 50; // 50 bytes below the threshold
+
+    CC->QuicCongestionControlOnDataSent(CC, 4 * DatagramPayloadLength);
+    QUIC_ACK_EVENT Ack1 = MakeAckEvent(1100000, 16, 16, 100); // crosses by 50 bytes
+    CC->QuicCongestionControlOnDataAcknowledged(CC, &Ack1);
+
+    ASSERT_EQ(Cubic->AimdWindow, Window + DatagramPayloadLength);
+    ASSERT_EQ(Cubic->AimdAccumulator, 50u);
+    ASSERT_LT(Cubic->AimdAccumulator, Cubic->AimdWindow);
+
+    // A further small ACK must not grow AimdWindow again.
+    QUIC_ACK_EVENT Ack2 = MakeAckEvent(1110000, 17, 17, 100);
+    CC->QuicCongestionControlOnDataAcknowledged(CC, &Ack2);
+    ASSERT_EQ(Cubic->AimdWindow, Window + DatagramPayloadLength);
 }
 
